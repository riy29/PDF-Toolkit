# PDF Tool Configuration

# LDAP Authentication (set USE_LDAP=true to enable)
USE_LDAP=false
LOCAL_SUPERUSER_USERNAME=superadmin
LOCAL_SUPERUSER_PASSWORD=ChangeMe123!
LOCAL_SUPERUSER_PASSWORD_HASH=
PDF_TOOL_ADMINS=
ALLOWED_AD_USERS=
DEFAULT_ALLOWED_TOOLS=
ACCESS_CONFIG_PATH=/tmp/pdf-compressor/access_control.json
LDAP_SERVER=ldap://localhost:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_ATTR=uid
LDAP_USER_DN_TEMPLATE={attr}={username},{base_dn}
LDAP_TIMEOUT=10
LDAP_USE_TLS=false
LDAP_USE_SSL=false

# LDAP Service Account (optional, for user queries)
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=password

# Flask Configuration
SECRET_KEY=change-me-in-production
MAX_UPLOAD_MB=512
MAX_BULK_TOTAL_MB=2048
MIN_TARGET_KB=10
MAX_TARGET_KB=10240
BULK_MAX_FILES=1000
COMPRESS_WORKERS=4
COMPRESS_FAST_MODE=true
COMPRESS_TOOL_TIMEOUT=45
LOG_DIR=/tmp/pdf-compressor/logs
BULK_RETENTION_SECONDS=1800
SESSION_TYPE=filesystem

# Redis Configuration (for sessions)
REDIS_URL=redis://localhost:6379/0
